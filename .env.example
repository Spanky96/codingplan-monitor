# ===== GLM 用量监控 配置 =====
# 用法:复制本文件为 .env 并按需修改   cp .env.example .env
# .env 已加入 .gitignore,不会提交(含密码等敏感信息)。

# 服务监听端口
PORT=4000

# 监听地址(0.0.0.0 = 允许局域网访问)
HOST=0.0.0.0

# 管理密码(账号增删改、Key 复制/创建/删除需校验)—— 请务必修改!
ADMIN_PASSWORD=123456

# 账号凭证加密密钥(accounts.json 中密码/Cookie/Token 落盘前用 AES-256-GCM 加密)
#   本地与服务器配置一致时,两边数据文件可互相拷贝;不一致时密文解不开会按明文兜底并告警
#   生成随机值: openssl rand -base64 32
#   未配置时从 ADMIN_PASSWORD 派生(单环境可用,但后续改管理密码会导致旧密文解不开)
# ACCOUNT_SECRET=

# 账号数据文件路径
#   本地运行留空即可,默认使用项目根目录下的 ./accounts.json
#   Docker 部署时由 docker-compose.yml 指定为 /app/data/accounts.json 以持久化
# ACCOUNTS_FILE=/app/data/accounts.json

# 运行环境(development / production)
NODE_ENV=production

# 智云抓取所用浏览器路径；macOS 和 Docker 可自动发现，其他环境按需设置
# TELECOMJS_CHROME_PATH=/usr/bin/chromium

# ===== 可选:中转站集成(不配置则相关功能自动隐藏/禁用) =====

# sub2api 中转站服务地址(监控页容量胶囊 / 实时调度·今日Token 面板代理拉取用)。
# 需中转站具备 weight-snapshot / user-activity-snapshot / user-usage-snapshot 快照端点
# (sub2api 的 lwsub2api 分支提供);留空 = 中转站功能整体关闭,面板与胶囊不展示。
# SUB2API_BASE_URL=http://your-sub2api-host:8090

# 中转站用户活动快照的 token 门禁,与中转站环境变量 ACTIVITY_SNAPSHOT_TOKEN 保持一致;
# 留空表示中转站未开启门禁(内网开放)。仅在配置了 SUB2API_BASE_URL 时有意义
# RELAY_SNAPSHOT_TOKEN=

# 模型调用页(models.html)的网关地址(OpenAI 兼容入口,含 /v1)。
# 留空 = 页面禁用并提示未配置
# MODELS_GATEWAY_URL=https://your-gateway.example/v1

# 凭证导出接口 /api/credentials 开关(供中转站外部渠道按账号名同步最新登录态)。
# 接受 1/true/yes;留空 = 路由不注册
# CREDENTIALS_EXPORT=1

# MiniMax 反向代理(/minimax/*)上游地址;models 模型调用页已直连网关,
# 本代理为兼容保留,留空 = 关闭(/minimax/* 返回 404)
# MINIMAX_PROXY_UPSTREAM=http://your-sub2api-host:8090
